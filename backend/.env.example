# Copy to .env and fill in real values. .env is gitignored.
#
#   cp .env.example .env

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me

# Never leave this on in production.
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API directly. The Vite dev server proxies /api,
# so these matter mainly when calling the API from elsewhere.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only used if you switch DATABASES to MySQL in config/settings.py.
DB_NAME=carkingdom
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
